# Cloudflare static-asset headers. Names under /img and /fonts carry content
# hashes or are never edited in place, so they can be cached for a year.
/img/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/og/*
  Cache-Control: public, max-age=86400
